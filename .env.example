# Supabase connection. When both are set, gallery-wall persists rooms in
# Supabase. When unset, it falls back to a local JSON file at
# data/rooms.json (dev only — won't work on read-only hosts like Vercel).
#
# Get these from your Supabase project: Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key for URL ingestion (the "Paste product URL" feature in
# the add-item form). Without this, the rest of the app still works — only
# URL ingestion is disabled.
#
# Get one at https://console.anthropic.com → Settings → API Keys.
ANTHROPIC_API_KEY=

# Optional: ScrapingBee API key. When set, the URL extractor falls back to
# ScrapingBee when a direct fetch hits 401/403/429/503/520+. This unlocks
# Akamai- and Cloudflare-protected sites like West Elm and Pottery Barn.
# Without it, those sites still work via the screenshot drop in the form.
#
# Get one at https://app.scrapingbee.com (free trial: 1000 credits, no card).
SCRAPINGBEE_API_KEY=

# Optional: Replicate API token. When set, each piece in the items list
# gets a "−BG" button that removes the listing-photo background. Costs
# ~$0.001 per image, ~5–8 seconds per call. Without it, the button still
# appears but the request returns an error.
#
# Get one at https://replicate.com/account/api-tokens.
REPLICATE_API_TOKEN=
